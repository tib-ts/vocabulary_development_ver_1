@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix skos: <http://www.w3.org/2004/02/skos/core#>.
@prefix dcterms: <http://purl.org/dc/terms/#>.
@prefix ex: <https://example.com/ns#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.

<https://example.com#88953004-da1d-4db1-bf0f-4c7747407213> rdf:type rdfs:Resource;
    dcterms:identifier "88953004-da1d-4db1-bf0f-4c7747407213";
    rdfs:label "process";
    dcterms:description "Process, i.e., a physical entity with a temporal evolution that 'has a meaning for the ontologist'";
    rdfs:seeAlso "url:https://terminology.tib.eu/ts/ontologies/m4i/terms?iri=http%3A%2F%2Fpurl.obolibrary.org%2Fobo%2FBFO_0000015";
    ex:status "draft";
    dcterms:created "2026-08-31"^^xsd:date;
    dcterms:modified "2026-08-31T08:51:20.772Z"^^xsd:dateTime.
<https://example.com#7ba0f509-9af7-4daf-a282-7b9f7d8cc046> rdf:type rdfs:Resource;
    dcterms:identifier "7ba0f509-9af7-4daf-a282-7b9f7d8cc046";
    rdfs:label "research project";
    dcterms:description "A research project";
    rdfs:seeAlso "url:https://terminology.tib.eu/ts/ontologies/m4i/terms?iri=https%3A%2F%2Fschema.org%2FResearchProject";
    ex:status "draft";
    dcterms:created "2026-08-31"^^xsd:date;
    dcterms:modified "2026-08-31T10:06:07.741Z"^^xsd:dateTime.
<https://example.com#aa0f7144-4d27-4e8b-9428-313285e26b02> rdf:type rdfs:Resource;
    dcterms:identifier "aa0f7144-4d27-4e8b-9428-313285e26b02";
    rdfs:label "agent";
    dcterms:description "An agent is something that bears some form of responsibility for an activity taking place, for the existence of an entity, or for another agent's activity.";
    rdfs:seeAlso "url:https://terminology.tib.eu/ts/ontologies/m4i/terms?iri=http%3A%2F%2Fwww.w3.org%2Fns%2Fprov%23Agent";
    ex:status "draft";
    dcterms:created "2026-08-31"^^xsd:date;
    dcterms:modified "2026-08-31T13:37:36.938Z"^^xsd:dateTime.
<https://example.com#6f9212ca-6719-4d7f-b899-035cd5c566b8> rdf:type rdfs:Resource;
    dcterms:identifier "6f9212ca-6719-4d7f-b899-035cd5c566b8";
    rdfs:label "dataset";
    dcterms:description "A collection of data, published or curated by a single source, and available for access or download in one or more representations.";
    rdfs:seeAlso "url:https://terminology.tib.eu/ts/ontologies/m4i/terms?iri=http%3A%2F%2Fwww.w3.org%2Fns%2Fdcat%23Dataset";
    ex:status "draft";
    dcterms:created "2026-09-02"^^xsd:date;
    dcterms:modified "2026-09-02T10:11:22.262Z"^^xsd:dateTime.
<https://example.com#7d762823-e3a1-4a46-8423-af1dd453728f> rdf:type rdfs:Resource;
    dcterms:identifier "7d762823-e3a1-4a46-8423-af1dd453728f";
    rdfs:label "role";
    dcterms:description "A role is the function of an entity or agent with respect to an activity, in the context of a usage, generation, invalidation, association, start, and end.";
    rdfs:seeAlso "url:https://terminology.tib.eu/ts/ontologies/m4i/terms?iri=http%3A%2F%2Fwww.w3.org%2Fns%2Fprov%23Role";
    ex:status "draft";
    dcterms:created "2026-09-02"^^xsd:date;
    dcterms:modified "2026-09-02T11:10:13.372Z"^^xsd:dateTime.
