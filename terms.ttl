<https://example.com#f04e5848-3d28-4145-8684-42f798b8343d> rdf:type rdfs:Resource;
    dcterms:identifier "f04e5848-3d28-4145-8684-42f798b8343d";
    rdfs:label "Uniaxial tensile test";
    dcterms:description "An experiment in which a specimen is pulled along one axis to measure its mechanical response to an applied tensile force";
    ex:status "draft";
    dcterms:created "2026-10-14"^^xsd:date;
    dcterms:modified "2026-10-14T09:19:40.416Z"^^xsd:dateTime.
<https://example.com#5ed011f0-1d16-4d2a-8d6b-75c220588661> rdf:type rdfs:Resource;
    dcterms:identifier "5ed011f0-1d16-4d2a-8d6b-75c220588661";
    rdfs:label "Gauge length";
    dcterms:description "The initial length of the specimen’s selected measurement region over which elongation is measured during the test.";
    ex:status "draft";
    dcterms:created "2026-10-14"^^xsd:date;
    dcterms:modified "2026-10-14T09:24:53.143Z"^^xsd:dateTime.
<https://example.com#2936b347-c204-4214-a058-90c77a419aa5> rdf:type rdfs:Resource;
    dcterms:identifier "2936b347-c204-4214-a058-90c77a419aa5";
    rdfs:label "Optotensile instrumentation suite";
    dcterms:description "The collection of electronic devices used to measure, record, and monitor a specimen’s response during a tensile test, combining optical imaging with force and displacement measurements.";
    ex:status "draft";
    dcterms:created "2026-10-14"^^xsd:date;
    dcterms:modified "2026-10-14T09:25:08.527Z"^^xsd:dateTime.
