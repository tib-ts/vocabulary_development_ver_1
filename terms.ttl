@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix skos: <http://www.w3.org/2004/02/skos/core#>.
@prefix dcterms: <http://purl.org/dc/terms/#>.
@prefix ex: <https://example.com/ns#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.

<https://example.com#6c36ea58-bb7f-4860-9b3a-a256c33ff6f6> rdf:type rdfs:Resource;
    dcterms:identifier "6c36ea58-bb7f-4860-9b3a-a256c33ff6f6";
    rdfs:label "testw";
    dcterms:description "A test can be considered a technical operation or procedure that consists of determination of one or more characteristics of a given product, process or service according to a specified procedure. Often a test is part of an experiment. The test result can be qualitative (yes/no), categorical, or quantitative (a measured value). It can be a personal observation or the output of a precision measuring instrument. [Wikipedia]";
    rdfs:seeAlso "url:https://terminology.tib.eu/ts/ontologies/afo/terms?iri=http%3A%2F%2Fpurl.allotrope.org%2Fontologies%2Fprocess%23AFP_0002834";
    ex:status "draft";
    dcterms:created "2026-10-21"^^xsd:date;
    dcterms:modified "2026-10-21T15:55:12.687Z"^^xsd:dateTime.
<https://example.com#1368b965-9170-4f3e-a0c4-79f8bcda3615> rdf:type rdfs:Resource;
    dcterms:identifier "1368b965-9170-4f3e-a0c4-79f8bcda3615";
    rdfs:label "car";
    dcterms:description "A car is a wheeled motor vehicle used primarily for the transportation of human passengers. Most definitions of the term specify that cars are designed to run primarily on roads, to have seating for one to eight people, to typically have four wheels, and to be constructed principally for the transport of people rather than goods.";
    rdfs:seeAlso "url:https://terminology.tib.eu/ts/ontologies/envo/terms?iri=http%3A%2F%2Fpurl.obolibrary.org%2Fobo%2FENVO_01000605";
    ex:status "accept";
    dcterms:created "2026-10-21"^^xsd:date;
    dcterms:modified "2026-10-21T16:12:22.405Z"^^xsd:dateTime.
<https://example.com#ff4f9740-2066-46d8-8e27-fa527b33ef79> rdf:type rdfs:Resource;
    dcterms:identifier "ff4f9740-2066-46d8-8e27-fa527b33ef79";
    rdfs:label "weather";
    dcterms:description "The day-to-day meteorological conditions, especially temperature, cloudiness, and rainfall, affecting a specific place.";
    rdfs:seeAlso "url:https://terminology.tib.eu/ts/ontologies/gemet/terms?iri=http%3A%2F%2Fwww.eionet.europa.eu%2Fgemet%2Fconcept%2F9269";
    ex:status "accept";
    dcterms:created "2026-10-22"^^xsd:date;
    dcterms:modified "2026-10-22T08:10:26.357Z"^^xsd:dateTime.
<https://example.com#4375a60f-a4a4-4c8d-8df2-ba683748d14c> rdf:type rdfs:Resource;
    dcterms:identifier "4375a60f-a4a4-4c8d-8df2-ba683748d14c";
    rdfs:label "weather";
    dcterms:description "Environmental variability which inheres in an astronomical body part or in outer space.";
    rdfs:seeAlso "url:https://terminology.tib.eu/ts/ontologies/envo2021/terms?iri=http%3A%2F%2Fpurl.obolibrary.org%2Fobo%2FENVO_01001078";
    ex:status "draft";
    dcterms:created "2026-10-23"^^xsd:date;
    dcterms:modified "2026-10-23T09:49:40.852Z"^^xsd:dateTime.
