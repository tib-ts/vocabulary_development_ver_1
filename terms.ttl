@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix skos: <http://www.w3.org/2004/02/skos/core#>.
@prefix dcterms: <http://purl.org/dc/terms/#>.
@prefix ex: <https://example.com/ns#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.

<https://example.com#2cde932d-e1c3-4dbb-aa9a-2eb0475f5ecf> rdf:type rdfs:Resource;
    dcterms:identifier "2cde932d-e1c3-4dbb-aa9a-2eb0475f5ecf";
    rdfs:label "Bullwhip Effect";
    dcterms:description "The bullwhip effect refers to demand distortions that amplify as information moves upstream in the supply chain, often due to forecast updates, order batching, and demand signal processing.";
    ex:status "draft";
    dcterms:created "2026-11-02"^^xsd:date;
    dcterms:modified "2026-11-02T08:02:34.129Z"^^xsd:dateTime.
<https://example.com#4b3b83dd-33b5-4d31-b352-abfb5a5d7d47> rdf:type rdfs:Resource;
    dcterms:identifier "4b3b83dd-33b5-4d31-b352-abfb5a5d7d47";
    rdfs:label "Capacity";
    dcterms:description "CAPACITY with respect to the Domain Semiconductor and Supply Chains Containing Semiconductor is the maximum number of products or a group of products a machine or a group of machines can produce. As soon as a machine has free capacity: 1. all lots which belongs to a priority class have to be dispatched immediately according to their priority rank.";
    ex:status "draft";    
    dcterms:created "2026-11-02"^^xsd:date;
    dcterms:modified "2026-11-02T08:05:16.422Z"^^xsd:dateTime.
<https://example.com#294e84a1-ebe9-4db0-8704-c5c28dfd309f> rdf:type rdfs:Resource;
    dcterms:identifier "294e84a1-ebe9-4db0-8704-c5c28dfd309f";
    rdfs:label "Costumer Data";
    dcterms:description "CUSTOMER DATA includes all information necessary to manage orders—such as identifiers, addresses, logistics preferences, and contractual conditions.";
    ex:status "draft";
    dcterms:created "2026-11-02"^^xsd:date;
    dcterms:modified "2026-11-02T08:06:00.945Z"^^xsd:dateTime.
<https://example.com#bd868a8d-dfac-41d3-a36a-81921602684a> rdf:type rdfs:Resource;
    dcterms:identifier "bd868a8d-dfac-41d3-a36a-81921602684a";
    rdfs:label "Demand";
    dcterms:description "Demand represents the quantity of products requested by customers.";
    ex:status "draft";
    dcterms:created "2026-11-02"^^xsd:date;
    dcterms:modified "2026-11-02T08:11:27.900Z"^^xsd:dateTime.
<https://example.com#16c40e41-dd1e-4092-a934-a57358c3b293> rdf:type rdfs:Resource;
    dcterms:identifier "16c40e41-dd1e-4092-a934-a57358c3b293";
    rdfs:label "Past Demand";
    dcterms:description "Past demand is the historical record of quantities of a product or service that customers requested or purchased over prior time periods, used as the basis for forecasting and planning";
    ex:status "draft";
    dcterms:created "2026-11-02"^^xsd:date;
    dcterms:modified "2026-11-02T08:14:00.593Z"^^xsd:dateTime.
<https://example.com#fabb0d0f-9a44-42d3-9b59-ad845f64eb8e> rdf:type rdfs:Resource;
    dcterms:identifier "fabb0d0f-9a44-42d3-9b59-ad845f64eb8e";
    rdfs:label "Pork Cycle";
    dcterms:description "The Pork Cycle is a metaphor for boom-and-bust investment patterns caused by delayed supply responses to demand conditions. It illustrates how shortages can trigger overinvestment, which later results in overcapacity, price declines, and underinvestment, perpetuating the cycle. This phenomenon typically occurs in industries where capacity has a limited lifetime (e.g., agriculture) or where growth and uncertainty make forecasts difficult (e.g., semiconductors)";
    ex:status "draft";    
    dcterms:created "2026-11-02"^^xsd:date;
    dcterms:modified "2026-11-02T08:16:13.076Z"^^xsd:dateTime.
<https://example.com#e9d90522-3eac-461e-a9f0-d06544c700cf> rdf:type rdfs:Resource;
    dcterms:identifier "e9d90522-3eac-461e-a9f0-d06544c700cf";
    rdfs:label "Supply Chain";
    dcterms:description "A supply chain is the network of organizations, resources, activities, and technologies involved in the production and delivery of a product from raw materials to the final customer. Supply chain management issues have become increasingly important to the semiconductor industry due to the global distribution of facilities and increasing numbers of firms specialising in particular stages.";
    ex:status "draft";
    dcterms:created "2026-11-02"^^xsd:date;
    dcterms:modified "2026-11-02T08:18:03.064Z"^^xsd:dateTime.
