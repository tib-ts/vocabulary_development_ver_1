@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix skos: <http://www.w3.org/2004/02/skos/core#>.
@prefix dcterms: <http://purl.org/dc/terms/#>.
@prefix ex: <https://example.com/ns#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.

<https://example.com#2cde932d-e1c3-4dbb-aa9a-2eb0475f5ecf> rdf:type rdfs:Resource;
    dcterms:identifier "2cde932d-e1c3-4dbb-aa9a-2eb0475f5ecf";
    rdfs:label "Bullwhip Effect";
    dcterms:description "The bullwhip effect refers to demand distortions that amplify as information moves upstream in the supply chain, often due to forecast updates, order batching, and demand signal processing.";
    dcterms:created "2026-11-02"^^xsd:date;
    dcterms:modified "2026-11-02T08:02:34.129Z"^^xsd:dateTime.
<https://example.com#4b3b83dd-33b5-4d31-b352-abfb5a5d7d47> rdf:type rdfs:Resource;
    dcterms:identifier "4b3b83dd-33b5-4d31-b352-abfb5a5d7d47";
    rdfs:label "Capacity";
    dcterms:description "CAPACITY with respect to the Domain Semiconductor and Supply Chains Containing Semiconductor is the maximum number of products or a group of products a machine or a group of machines can produce. As soon as a machine has free capacity: 1. all lots which belongs to a priority class have to be dispatched immediately according to their priority rank.";
    dcterms:created "2026-11-02"^^xsd:date;
    dcterms:modified "2026-11-02T08:05:16.422Z"^^xsd:dateTime.
