    dcterms:identifier "24c12879-0a5d-4b9c-b459-10183ea8c21c";
    rdfs:label "pain";
    dcterms:description "Pain is an unpleasant sensory and emotional experience associated with actual or potential tissue damage, or described in terms of such damage.";
